{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./.test-out",
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": false,
    "noEmit": false,
    "types": [],
